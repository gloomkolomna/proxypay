# ── Общие ──
APP_ENV=production                  # production | dev (dev включает /dev-login)
DATABASE_URL=sqlite:///./pay-gateway.db
SITE_URL=https://belovolovhome.ru
SECRET_KEY=change-me                # JWT админки (свой, не драконий)
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# ── Админка: VK ID (ОТДЕЛЬНОЕ приложение «ProxyPay Admin», не драконье) ──
ADMIN_VK_CLIENT_ID=
ADMIN_VK_CLIENT_SECRET=
ADMIN_VK_REDIRECT_URI=https://belovolovhome.ru/pay/api/auth/vk-callback
ADMIN_VK_ALLOWED_IDS=400977

# ── MONETA (PayAnyWay) ──
MONETA_MNT_ID=
MONETA_INTEGRITY_CODE=
MONETA_TEST_MODE=1
MONETA_NO_SIGNATURE_FORM=
MONETA_NO_SIGNATURE_CALLBACK=
MONETA_CALLBACK_IPS=193.176.92.70

# ── Заказы / тест-блок (начальные значения; дальше — в БД, тумблер в админке) ──
ORDER_TTL_MINUTES=60
PAYMENTS_TEST_MODE=0
PAYMENTS_TEST_VK_ID=400977

# ── Scheduler / вебхуки ──
SCHEDULER_INTERVAL_SECONDS=30
WEBHOOK_TIMEOUT_SECONDS=10
